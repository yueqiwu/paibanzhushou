<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 班次闹钟：写系统闹钟 + 到点提醒 + 重启后恢复 -->
    <uses-permission android:name="android.permission.SET_ALARM" />
    <!-- 精确闹钟：API 31/32 用 SCHEDULE_EXACT_ALARM（可被用户关掉），
         API 33+ 用 USE_EXACT_ALARM（闹钟类应用自动授予）。
         两者都不声明时 setAlarmClock 会抛 SecurityException，闹钟一个都写不进去。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 常驻前台服务：ColorOS 会延后「后台闲置」应用的精确闹钟，前台服务保持应用活跃 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 11+ 包可见性：允许本应用检测 / 拉起微信 -->
    <queries>
        <package android:name="com.tencent.mm" />
    </queries>

    <application
        android:name=".PaibanApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Paibanzhushou">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Paibanzhushou"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 拉起微信小程序：无界面的能力入口，可用 deeplink / adb / 代码调用触发 -->
        <activity
            android:name=".wx.WxLaunchMiniProgramActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="miniprogram"
                    android:scheme="paibanzhushou" />
            </intent-filter>
        </activity>

        <!-- 班次闹钟到点后的全屏响铃页（锁屏也能盖上来） -->
        <activity
            android:name=".alarm.AlarmRingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Paibanzhushou.Alarm"
            android:turnScreenOn="true" />

        <!-- 到点响铃：声音由这个前台服务播放，不依赖界面能否被拉起 -->
        <service
            android:name=".alarm.AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm" />
        </service>

        <!-- 常驻前台服务：开着班次闹钟时保持进程活跃，避免 ROM 把闹钟延后 -->
        <service
            android:name=".alarm.AlarmKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm" />
        </service>

        <!-- 班次闹钟到点 -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- 重启后 AlarmManager 里写的闹钟会被清空，这里补写一遍 -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- 解锁后才读得到应用私有存储，真正的补写发生在这里 -->
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 微信回调必须位于 <applicationId>.wxapi.WXEntryActivity -->
        <activity
            android:name=".wxapi.WXEntryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.bilu.paibanzhushou"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>