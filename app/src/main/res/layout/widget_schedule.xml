<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_dot"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="班表小历"
            android:textColor="#0B1020"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:includeFontPadding="false"
            android:text="11月"
            android:textColor="#9AA3B2"
            android:textSize="10sp" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/w_person"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="默认人员"
            android:textColor="#7A8494"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:background="#120B1020"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_day0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="今天"
            android:textColor="#4A90E2"
            android:textSize="9.5sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_date0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:text="11"
            android:textColor="#4A90E2"
            android:textSize="19sp"
            android:textStyle="bold"
            android:background="@drawable/widget_today_bg"
            android:paddingStart="8dp"
            android:paddingTop="1dp"
            android:paddingEnd="8dp"
            android:paddingBottom="1dp" />
        <TextView
            android:id="@+id/w_ban0"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginStart="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/pill_none"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="1dp"
            android:paddingEnd="1dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="9.5sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_day1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="一"
            android:textColor="#9AA3B2"
            android:textSize="9.5sp"
            android:textStyle="normal" />
        <TextView
            android:id="@+id/w_date1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:text="12"
            android:textColor="#0B1020"
            android:textSize="19sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_ban1"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginStart="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/pill_none"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="1dp"
            android:paddingEnd="1dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="9.5sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_day2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="二"
            android:textColor="#9AA3B2"
            android:textSize="9.5sp"
            android:textStyle="normal" />
        <TextView
            android:id="@+id/w_date2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:text="13"
            android:textColor="#0B1020"
            android:textSize="19sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_ban2"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginStart="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/pill_none"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="1dp"
            android:paddingEnd="1dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="9.5sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_day3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="三"
            android:textColor="#9AA3B2"
            android:textSize="9.5sp"
            android:textStyle="normal" />
        <TextView
            android:id="@+id/w_date3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:text="14"
            android:textColor="#0B1020"
            android:textSize="19sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_ban3"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginStart="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/pill_none"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="1dp"
            android:paddingEnd="1dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="9.5sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_day4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="四"
            android:textColor="#9AA3B2"
            android:textSize="9.5sp"
            android:textStyle="normal" />
        <TextView
            android:id="@+id/w_date4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:text="15"
            android:textColor="#0B1020"
            android:textSize="19sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_ban4"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginStart="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/pill_none"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="1dp"
            android:paddingEnd="1dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="9.5sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_day5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="五"
            android:textColor="#9AA3B2"
            android:textSize="9.5sp"
            android:textStyle="normal" />
        <TextView
            android:id="@+id/w_date5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:text="16"
            android:textColor="#0B1020"
            android:textSize="19sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_ban5"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginStart="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/pill_none"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="1dp"
            android:paddingEnd="1dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="9.5sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_day6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="六"
            android:textColor="#9AA3B2"
            android:textSize="9.5sp"
            android:textStyle="normal" />
        <TextView
            android:id="@+id/w_date6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:text="17"
            android:textColor="#0B1020"
            android:textSize="19sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_ban6"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginStart="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/pill_none"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="1dp"
            android:paddingEnd="1dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="9.5sp" />
    </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/w_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginTop="6dp"
        android:text="点击查看完整排班 ›"
        android:textColor="#9AA3B2"
        android:textSize="9.5sp" />
</LinearLayout>