    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_date6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" android:textColor="#333333" android:textSize="12sp" />
        <TextView android:id="@+id/w_ban6" android:layout_width="92dp" android:layout_height="20dp" android:gravity="center" android:text="" android:textColor="#FFFFFF" android:textSize="11sp" android:background="#F0F0F0" />
